        <mxCell id="EzFPSGaiBhMkyjTuJ7ON-75" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Resricciones no estructurales:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-Cada país tiene varios circuitos&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-Un piloto puede conducir distintos autos en distintas temporadas&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-para cada temporada el auto tendra un numero de competidor asignado&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-Cada temporada corresponde a un ùnico año.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-Cada escuderìa dispone de dos autos por temporada.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-Todo resultado corresponde a un ùnico piloto. un ùnico auto y un ùnico gran premio.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-cada circuito pertenece a un&amp;nbsp; gran premio en una fecha determinada&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="335" x="450" y="-1497" as="geometry" />
        </mxCell>
